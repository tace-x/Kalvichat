# ============================================================
# KALVI CHAT — ENVIRONMENT VARIABLE TEMPLATE
# ============================================================
#
# IMPORTANT:
# This file is a TEMPLATE only.
# Never put real API keys, passwords, service-account JSON,
# or session secrets in this file or commit them to GitHub.
#
# For production, configure the real values in:
# Vercel → Project → Settings → Environment Variables
# ============================================================


# ============================================================
# PUBLIC FIREBASE WEB APP CONFIGURATION
# ============================================================
# Safe to expose to browser code.
# These MUST use the VITE_ prefix because the frontend needs them.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ============================================================
# FIREBASE ADMIN — SERVER ONLY
# ============================================================
# NEVER prefix this with VITE_.
# Required by server-side API routes such as /api/translate.
#
# Put the complete Firebase service-account JSON on ONE line
# in Vercel's environment-variable value.

FIREBASE_SERVICE_ACCOUNT_JSON=


# ============================================================
# ADMIN AUTHENTICATION — SERVER ONLY
# ============================================================
# These values must NEVER be exposed to browser code.

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Use a long, cryptographically random secret.
# Recommended: 32+ random characters.

ADMIN_SESSION_SECRET=


# ============================================================
# AI TRANSLATION PROVIDERS — SERVER ONLY
# ============================================================
# Configure one or more providers.
#
# The application should skip any provider whose API key is
# missing and continue to the next available provider.
#
# NEVER use VITE_ prefixes for these keys.

GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=


# ============================================================
# TRANSLATION PROVIDER TIMEOUT
# ============================================================
# Maximum time allowed for an individual provider request.
#
# 12000 ms = 12 seconds.
#
# Keep this below Vercel's overall function execution limit.
# The translation router should additionally enforce its
# total provider-attempt budget.

TRANSLATION_PROVIDER_TIMEOUT_MS=12000


# ============================================================
# AI MODEL CONFIGURATION
# ============================================================
# These can be overridden in Vercel without changing source code.

# Primary translation provider
GEMINI_MODEL=gemini-3.5-flash

# Secondary fallback provider
GROQ_MODEL=llama-3.3-70b-versatile

# Final fallback provider
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
