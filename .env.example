# PUBLIC — safe Firebase web-app configuration (available to browser code)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY — configure in Vercel; never prefix these with VITE_
# Firebase Admin service account JSON, on one line. Required by /api/translate.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin credentials are read only by Vercel server functions.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use at least 32 cryptographically random characters.
ADMIN_SESSION_SECRET=

# Configure one or more translation providers. Missing providers are skipped.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Per-provider request timeout. Keep below Vercel's overall function limit.
TRANSLATION_PROVIDER_TIMEOUT_MS=12000

# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
