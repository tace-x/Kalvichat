# ============================================================
# KALVI CHAT — ENVIRONMENT VARIABLES
# ============================================================


# ============================================================
# PUBLIC — Firebase Web App Configuration
# ============================================================
# These values are safe for browser-side Firebase initialization.
# Vite exposes variables beginning with VITE_ to client-side code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ============================================================
# SERVER ONLY — Firebase Admin
# ============================================================
# NEVER prefix server secrets with VITE_.
# Configure these in Vercel Environment Variables.
#
# Firebase Admin service-account JSON must be stored as ONE LINE.

FIREBASE_SERVICE_ACCOUNT_JSON=


# ============================================================
# SERVER ONLY — Admin Authentication
# ============================================================

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Use at least 32 cryptographically random characters.
ADMIN_SESSION_SECRET=


# ============================================================
# SERVER ONLY — Translation Providers
# ============================================================
# Configure one or more providers.
# Providers without API keys are automatically skipped.
#
# NEVER expose these values to browser/client code.
# NEVER use VITE_ prefixes for provider API keys.

GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=


# ============================================================
# SERVER ONLY — Translation Provider Limits
# ============================================================
#
# Maximum time allowed for an individual provider request.
# This prevents one provider from blocking translation for too long.
#
# Overall provider budget is the maximum total time available
# for the entire provider fallback phase.
#
# The provider budget MUST remain greater than the individual
# provider timeout so fallback providers can still be attempted.

TRANSLATION_PROVIDER_TIMEOUT_MS=5000
TRANSLATION_PROVIDER_BUDGET_MS=9000


# ============================================================
# SERVER ONLY — Translation Provider Models
# ============================================================
# These are optional model overrides.
# The application may use its internal defaults when omitted.

GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
